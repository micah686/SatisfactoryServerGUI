<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SatisfactoryServerGUI.ViewModels"
        xmlns:views="clr-namespace:SatisfactoryServerGUI.Views"
        x:Class="SatisfactoryServerGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="720"
        MinWidth="820" MinHeight="540"
        Title="Satisfactory Server GUI">

    <Grid ColumnDefinitions="280,*" RowDefinitions="*,Auto">

        <!-- Left: profile pane -->
        <Border Grid.Column="0" Grid.Row="0" BorderBrush="#333" BorderThickness="0,0,1,0">
            <ContentControl Content="{Binding ProfilePane}" />
        </Border>

        <!-- Right: tabbed content -->
        <TabControl Grid.Column="1" Grid.Row="0" Margin="4">
            <TabItem Header="Dashboard">
                <ContentControl Content="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="Console">
                <ContentControl Content="{Binding Console}" />
            </TabItem>
            <TabItem Header="Saves">
                <ContentControl Content="{Binding Saves}" />
            </TabItem>
            <TabItem Header="Settings">
                <ContentControl Content="{Binding Settings}" />
            </TabItem>
            <TabItem Header="Auth">
                <ContentControl Content="{Binding Auth}" />
            </TabItem>
            <TabItem Header="Local Server" IsVisible="{Binding IsLocalServerTabVisible}">
                <ContentControl Content="{Binding LocalServer}" />
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0"
                Padding="10,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                         Fill="{Binding ConnectionStatus, Converter={StaticResource StatusToBrush}}" />
                <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
