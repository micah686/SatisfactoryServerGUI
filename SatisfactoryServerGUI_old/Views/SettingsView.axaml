<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SatisfactoryServerGUI.ViewModels"
             x:Class="SatisfactoryServerGUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Load settings" Command="{Binding RefreshCommand}" />
            <TextBlock VerticalAlignment="Center" Foreground="#9E9E9E"
                       Text="{Binding IsCreativeEnabled, StringFormat='Creative mode: {0}'}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*">

            <!-- Server options -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,6,0">
                <TextBlock Grid.Row="0" Text="Server Options" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding ServerOptions}" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="2" Content="Apply server options" Margin="0,6,0,0"
                        Command="{Binding ApplyServerOptionsCommand}" />
            </Grid>

            <!-- Advanced game settings -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="6,0,0,0">
                <TextBlock Grid.Row="0" Text="Advanced Game Settings" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding AdvancedSettings}" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="2" Content="Apply advanced settings" Margin="0,6,0,0"
                        Command="{Binding ApplyAdvancedSettingsCommand}" />
            </Grid>
        </Grid>

        <!-- Admin actions -->
        <Border Grid.Row="2" Background="#252525" CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Administration" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Watermark="New server name" Text="{Binding NewServerName}" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="Rename" Command="{Binding RenameCommand}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Watermark="New client password" PasswordChar="•"
                             Text="{Binding NewClientPassword}" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="Set client pw" Command="{Binding SetClientPasswordCommand}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Watermark="New admin password" PasswordChar="•"
                             Text="{Binding NewAdminPassword}" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="Set admin pw" Command="{Binding SetAdminPasswordCommand}" />
                </Grid>
                <Button Content="Shut down server" HorizontalAlignment="Left"
                        Background="#5A2020" Command="{Binding ShutdownCommand}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusIsError, Converter={StaticResource BoolToBrush}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
