<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SatisfactoryServerGUI.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="SatisfactoryServerGUI.Views.Pages.AuthenticationView"
             x:DataType="vm:AuthenticationViewModel">

    <Design.DataContext>
        <vm:AuthenticationViewModel/>
    </Design.DataContext>

    <SmoothScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="16">

            <!-- ── Auth status strip ────────────────────────────── -->
            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                            Width="40" Height="40" CornerRadius="10"
                            Background="#2056C98A"
                            Margin="0 0 14 0">
                        <PathIcon Data="{x:Static MaterialIcons.ShieldAccount}"
                                  Width="22" Height="22"
                                  Foreground="#56C98A"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="Authenticated as Admin"/>
                        <TextBlock Classes="faint" FontSize="12"
                                   Text="Bearer token verified for 192.168.1.42:7777 · privilege level Administrator"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="badge ok" Margin="12 0 0 0">
                        <StackPanel>
                            <PathIcon Data="{x:Static MaterialIcons.CheckDecagram}"
                                      Width="11" Height="11"/>
                            <TextBlock Text="Token valid"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Two-panel layout ─────────────────────────────── -->
            <Grid ColumnDefinitions="200,16,*">

                <!-- Left: method navigation -->
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="section-label" Text="METHOD" Margin="4 0 0 6"/>

                    <Button Classes="auth-nav active"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static MaterialIcons.KeyVariant}"
                                      Width="14" Height="14"/>
                            <TextBlock Text="API token"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="auth-nav"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static MaterialIcons.LockCheckOutline}"
                                      Width="14" Height="14"/>
                            <TextBlock Text="Password login"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="auth-nav"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static MaterialIcons.ShieldAccountOutline}"
                                      Width="14" Height="14"/>
                            <TextBlock Text="Claim server"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="auth-nav"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static MaterialIcons.LockOpenVariantOutline}"
                                      Width="14" Height="14"/>
                            <TextBlock Text="Passwords"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: panel content -->
                <StackPanel Grid.Column="2" Spacing="14">

                    <!-- API Token panel -->
                    <Border Classes="card" Padding="0" ClipToBounds="True">
                        <StackPanel>
                            <Border Padding="16 12"
                                    BorderBrush="{DynamicResource ControlBorderColor}"
                                    BorderThickness="0 0 0 1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0"
                                              Data="{x:Static MaterialIcons.KeyVariant}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextFillColor2}"
                                              Margin="0 0 8 0"/>
                                    <TextBlock Grid.Column="1" Classes="card-title"
                                               Text="API authentication token"/>
                                    <TextBlock Grid.Column="2" Classes="mono faint"
                                               FontSize="10"
                                               Text="VerifyAuthenticationToken"/>
                                </Grid>
                            </Border>

                            <StackPanel Margin="16" Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                               Text="Bearer token"/>
                                    <TextBox PlaceholderText="ApiToken eyJ…"
                                             Text="ApiToken eyJwiOiI4M2Rm…a91c"
                                             PasswordChar="•"/>
                                    <TextBlock Classes="faint" FontSize="11"
                                               Text="Stored with the profile and sent as the Authorization header on every request."/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Theme="{DynamicResource AccentButtonTheme}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{x:Static MaterialIcons.ShieldAccount}"
                                                      Width="14" Height="14"/>
                                            <TextBlock Text="Verify token"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Classes="badge ok">
                                        <StackPanel>
                                            <PathIcon Data="{x:Static MaterialIcons.CheckDecagram}"
                                                      Width="11" Height="11"/>
                                            <TextBlock Text="Valid — 204 No Content"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Classes="row-sep"/>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0"
                                              Data="{x:Static MaterialIcons.LockOpenVariantOutline}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource TextFillColor3}"
                                              Margin="0 0 12 0"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   Text="Passwordless login"/>
                                        <TextBlock Classes="faint" FontSize="11"
                                                   Text="Join as a player when the server has no client protection password."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Margin="8 0 0 0">Login</Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Admin password -->
                    <Border Classes="card" Padding="0" ClipToBounds="True">
                        <StackPanel>
                            <Border Padding="16 12"
                                    BorderBrush="{DynamicResource ControlBorderColor}"
                                    BorderThickness="0 0 0 1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0"
                                              Data="{x:Static MaterialIcons.ShieldAccountOutline}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextFillColor2}"
                                              Margin="0 0 8 0"/>
                                    <TextBlock Grid.Column="1" Classes="card-title"
                                               Text="Admin password"/>
                                    <TextBlock Grid.Column="2" Classes="mono faint"
                                               FontSize="10"
                                               Text="SetAdminPassword"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16" Spacing="10">
                                <TextBlock Classes="faint" FontSize="12"
                                           Text="Invalidates all existing admin &amp; client tokens. Required to administer the server."/>
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="New password"/>
                                        <TextBox PlaceholderText="New password" PasswordChar="•"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" VerticalAlignment="Bottom"
                                            Theme="{DynamicResource AccentButtonTheme}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{x:Static MaterialIcons.CheckDecagram}"
                                                      Width="13" Height="13"/>
                                            <TextBlock Text="Update"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Client password -->
                    <Border Classes="card" Padding="0" ClipToBounds="True">
                        <StackPanel>
                            <Border Padding="16 12"
                                    BorderBrush="{DynamicResource ControlBorderColor}"
                                    BorderThickness="0 0 0 1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0"
                                              Data="{x:Static MaterialIcons.AccountGroupOutline}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextFillColor2}"
                                              Margin="0 0 8 0"/>
                                    <TextBlock Grid.Column="1" Classes="card-title"
                                               Text="Client protection password"/>
                                    <TextBlock Grid.Column="2" Classes="mono faint"
                                               FontSize="10"
                                               Text="SetClientPassword"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16" Spacing="10">
                                <TextBlock Classes="faint" FontSize="12"
                                           Text="Players must enter this to join. Leave empty to let anyone join as a client."/>
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="New password"/>
                                        <TextBox PlaceholderText="Leave empty to remove" PasswordChar="•"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" VerticalAlignment="Bottom"
                                            Theme="{DynamicResource AccentButtonTheme}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{x:Static MaterialIcons.CheckDecagram}"
                                                      Width="13" Height="13"/>
                                            <TextBlock Text="Update"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </SmoothScrollViewer>

</UserControl>
