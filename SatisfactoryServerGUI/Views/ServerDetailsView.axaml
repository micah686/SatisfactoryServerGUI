<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SatisfactoryServerGUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="SatisfactoryServerGUI.Views.ServerDetailsView"
             x:DataType="vm:ServerDetailsViewModel">

  <Grid RowDefinitions="Auto,*" Margin="16">
    <!-- Top Controls -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
      <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
      <CheckBox Content="Auto Refresh" IsChecked="{Binding IsAutoRefresh}"/>
      <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="4" Padding="8,4"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding IsApiConnected}"/>
          <Ellipse Width="10" Height="10" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsApiConnected}"/>
          <TextBlock Text="{Binding ApiStatus}" VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <!-- IP Addresses -->
        <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="4" Padding="16">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="External IP:" VerticalAlignment="Center" Width="100"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExternalIp}" IsReadOnly="True" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Internal IP:" VerticalAlignment="Center" Width="100"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InternalIp}" IsReadOnly="True" Margin="0,0,0,8"/>

            <Button Grid.Row="2" Grid.Column="1" Content="Refresh IPs" Command="{Binding RefreshIpsCommand}" HorizontalAlignment="Left"/>
          </Grid>
        </Border>

        <!-- Server State -->
        <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="4" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Server State" FontWeight="SemiBold" FontSize="14"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Server Name" Opacity="0.6" FontSize="11"/>
                <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                <TextBlock Text="Session Name" Opacity="0.6" FontSize="11"/>
                <TextBlock Text="{Binding ActiveSessionName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Players" Opacity="0.6" FontSize="11"/>
                <TextBlock FontWeight="SemiBold">
                  <Run Text="{Binding ConnectedPlayers}"/>
                  <Run Text="/"/>
                  <Run Text="{Binding PlayerLimit}"/>
                </TextBlock>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                <TextBlock Text="Game Phase" Opacity="0.6" FontSize="11"/>
                <TextBlock Text="{Binding GamePhase}" FontWeight="SemiBold"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Status" Opacity="0.6" FontSize="11"/>
                <TextBlock Text="{Binding GameStatusText}" FontWeight="SemiBold"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                <TextBlock Text="Average Tick Rate" Opacity="0.6" FontSize="11"/>
                <TextBlock Text="{Binding AverageTickRate, StringFormat='{}{0:F2}'}" FontWeight="SemiBold"/>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Tech Tier" Opacity="0.6" FontSize="11"/>
                <TextBlock Text="{Binding TechTier}" FontWeight="SemiBold"/>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,8">
                <TextBlock Text="Last Save" Opacity="0.6" FontSize="11"/>
                <TextBlock Text="{Binding LastSaveTime}" FontWeight="SemiBold"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
